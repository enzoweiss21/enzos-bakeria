  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameManager
  days:
  - title: Day 1
    intro: 'Your very first day running Enzo''s Bakery!


      Customers will order Bread (just flour) and Cookies (flour + chocolate). Take their order, mix the dough, bake it, and serve it before they lose their patience.'
    goal: 75
    menu: 0700000008000000i
    spawnInterval: 12
    doubleOrderChance: 0
    hurriedChance: 0
    grandmaChance: 0.15
    hasCritic: 0
    berriesUnlocked: 0
  - title: Day 2
    intro: 'New on the menu: Cupcakes! Flour + berries makes batter. Bake it, then frost it at the frosting station (hold E).


      Watch for customers in a hurry (marked with !): very little patience, but big tips.'
    goal: 120
    menu: 07000000080000000a000000i
    spawnInterval: 10.5
    doubleOrderChance: 0.1
    hurriedChance: 0.2
    grandmaChance: 0.15
    hasCritic: 0
    berriesUnlocked: 1
  - title: Day 3
    intro: 'The big day. Lots of customers order two things at once, and a famous food critic (marked with a star) is coming at lunchtime.


      Serve the critic only PERFECT bakes and they''ll pay triple!'
    goal: 180
    menu: 07000000080000000a000000i
    spawnInterval: 9
    doubleOrderChance: 0.35
    hurriedChance: 0.25
    grandmaChance: 0.12
    hasCritic: 1
    berriesUnlocked: 1
  dayLengthSeconds: 150
  openHour: 8
