  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameManager
  days:
  - title: Day 1
    intro: 'Your very first day running Enzo''s Bakery!


      Customers will order Bread (just flour) and Cookies (flour + chocolate). Take their order, mix the dough, bake it, and serve it before they lose their patience.'
    goal: 75
    menu: 0700000008000000i
    spawnInterval: 12
    doubleOrderChance: 0
    hurriedChance: 0
    grandmaChance: 0.15
    hasCritic: 0
    berriesUnlocked: 0
  - title: Day 2
    intro: 'New on the menu: Cupcakes! Flour + berries makes batter. Bake it, then frost it at the frosting station (hold E).


      Watch for customers in a hurry (marked with a clock): very little patience, but big tips.'
    goal: 105
    menu: 07000000080000000a000000i
    spawnInterval: 11
    doubleOrderChance: 0.1
    hurriedChance: 0.15
    grandmaChance: 0.15
    hasCritic: 0
    berriesUnlocked: 1
  - title: Day 3
    intro: 'The big day. Lots of customers order two things at once, and a famous food critic (marked with a star) is coming at lunchtime.


      Serve the critic only PERFECT bakes and they''ll pay triple!'
    goal: 160
    menu: 07000000080000000a000000i
    spawnInterval: 10
    doubleOrderChance: 0.3
    hurriedChance: 0.2
    grandmaChance: 0.12
    hasCritic: 1
    berriesUnlocked: 1
  dayLengthSeconds: 150
  openHour: 8
  lastCallHour: 15.5
  closeHour: 16
  rushHour: 11.5
  upgrades:
  - id: 1
    displayName: Third Oven
    description: Fire up the spare oven.
    price: 70
    icon: {fileID: 21300000, guid: 9cc205fde27674706be16e63a94dfcc3, type: 3}
  - id: 0
    displayName: Turbo Ovens
    description: Everything bakes 35% faster.
    price: 60
    icon: {fileID: 21300000, guid: 35f8d6229093c48bbab75b8ffc4a42f8, type: 3}
  - id: 2
    displayName: Comfy Chairs
    description: Customers wait 25% longer.
    price: 55
    icon: {fileID: 21300000, guid: d2a27fde4408b496e900a1616a93124c, type: 3}
  - id: 3
    displayName: Quick Whisk
    description: Mix dough and frost cupcakes twice as fast.
    price: 40
    icon: {fileID: 21300000, guid: 0778768e658bd479c971c4af4071f41e, type: 3}
  - id: 4
